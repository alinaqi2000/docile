{
    "name": "docile/bus",
    "description": "Docile CQRS message bus — CommandBus, QueryBus, handler discovery, and middleware pipeline.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ali Naqi Al-Musawi",
            "email": "alinaqi2000@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Docile\\Bus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Docile\\Bus\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
