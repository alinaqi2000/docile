{
    "name": "docile/doctrine",
    "description": "Doctrine ORM 3 bridge for the Docile framework — repository pattern, migrations, DDD-first",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Ali Naqi Al-Musawi", "email": "alinaqi2000@gmail.com"}],
    "require": {
        "php": "^8.3",
        "doctrine/orm": "^3.0",
        "doctrine/dbal": "^4.0",
        "docile/foundation": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0"
    },
    "autoload": {"psr-4": {"Docile\\Doctrine\\": "src/"}},
    "autoload-dev": {"psr-4": {"Docile\\Doctrine\\Tests\\": "tests/"}}
}
