{
  "name": "docile/testing",
  "description": "First-party testing utilities for the Docile framework",
  "type": "library",
  "license": "MIT",
  "authors": [{"name": "Ali Naqi Al-Musawi", "email": "alinaqi2000@gmail.com"}],
  "require": {
    "php": ">=8.3",
    "phpunit/phpunit": "^11.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "psr/http-message": "^2.0",
    "docile/foundation": "*",
    "docile/http": "*",
    "docile/console": "*"
  },
  "autoload": {"psr-4": {"Docile\\Testing\\": "src/"}},
  "autoload-dev": {"psr-4": {"Docile\\Testing\\Tests\\": "tests/"}},
  "minimum-stability": "stable",
  "config": {"sort-packages": true},
  "extra": {"branch-alias": {"dev-main": "0.1-dev"}}
}
