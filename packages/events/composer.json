{
  "name": "docile/events",
  "description": "Docile PSR-14 event dispatcher with attribute-based listener discovery.",
  "type": "library",
  "license": "MIT",
  "authors": [{"name": "Ali Naqi Al-Musawi", "email": "alinaqi2000@gmail.com"}],
  "require": {
    "php": ">=8.3",
    "psr/event-dispatcher": "^1.0"
  },
  "provide": {
    "psr/event-dispatcher-implementation": "1.0"
  },
  "autoload": {"psr-4": {"Docile\\Events\\": "src/"}},
  "autoload-dev": {"psr-4": {"Docile\\Events\\Tests\\": "tests/"}},
  "minimum-stability": "stable",
  "config": {"sort-packages": true},
  "extra": {"branch-alias": {"dev-main": "0.1-dev"}}
}
