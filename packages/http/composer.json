{
  "name": "docile/http",
  "description": "Docile PSR-7/15 HTTP kernel with middleware pipeline, response factories, and SAPI emitter.",
  "type": "library",
  "license": "MIT",
  "authors": [{"name": "Ali Naqi Al-Musawi", "email": "alinaqi2000@gmail.com"}],
  "require": {
    "php": ">=8.3",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "psr/container": "^2.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "autoload": {"psr-4": {"Docile\\Http\\": "src/"}},
  "autoload-dev": {"psr-4": {"Docile\\Http\\Tests\\": "tests/"}},
  "minimum-stability": "stable",
  "config": {"sort-packages": true},
  "extra": {"branch-alias": {"dev-main": "0.1-dev"}}
}