{
    "name": "docile/docile",
    "description": "Docile — a DDD-first, strict-typed, zero-magic PHP framework. Monorepo for all docile/* packages.",
    "type": "project",
    "keywords": ["docile", "framework", "ddd", "psr", "api", "realtime", "microservice"],
    "homepage": "https://github.com/docile-php/docile",
    "license": "MIT",
    "authors": [
        {
            "name": "Ali Naqi Al-Musawi",
            "email": "alinaqi2000@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "autoload": {
        "psr-4": {
            "Docile\\Bus\\": "packages/bus/src/",
            "Docile\\Config\\": "packages/config/src/",
            "Docile\\Console\\": "packages/console/src/",
            "Docile\\Container\\": "packages/container/src/",
            "Docile\\Events\\": "packages/events/src/",
            "Docile\\Foundation\\": "packages/foundation/src/",
            "Docile\\Http\\": "packages/http/src/",
            "Docile\\Routing\\": "packages/routing/src/",
            "Docile\\Support\\": "packages/support/src/",
            "Docile\\Validation\\": "packages/validation/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Docile\\Bus\\Tests\\": "packages/bus/tests/",
            "Docile\\Config\\Tests\\": "packages/config/tests/",
            "Docile\\Console\\Tests\\": "packages/console/tests/",
            "Docile\\Container\\Tests\\": "packages/container/tests/",
            "Docile\\Events\\Tests\\": "packages/events/tests/",
            "Docile\\Foundation\\Tests\\": "packages/foundation/tests/",
            "Docile\\Http\\Tests\\": "packages/http/tests/",
            "Docile\\Routing\\Tests\\": "packages/routing/tests/",
            "Docile\\Support\\Tests\\": "packages/support/tests/",
            "Docile\\Validation\\Tests\\": "packages/validation/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.999"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
